#!/usr/bin/env bash
set -euo pipefail

BRANCH="${BRANCH:-main}"
PROFILES_URL="https://raw.githubusercontent.com/7069wrk/CSILinux-Powerup/${BRANCH}/profiles.conf"
LOCAL_PROFILES="${LOCAL_PROFILES:-./profiles.conf}"

LOG_ROOT="/var/log/buildit"
RUN_ID="$(date +%Y%m%d-%H%M%S)"
RUN_DIR="${LOG_ROOT}/runs/${RUN_ID}"
LOG_FILE="${RUN_DIR}/full.log"

DRY_RUN=0
PROFILE=""

tmp_conf=""
tmp_manifest=""

cleanup() {
  local exit_code=$?
  if [[ -n "${tmp_conf:-}" && -f "${tmp_conf:-}" ]]; then
    rm -f "$tmp_conf"
  fi
  if [[ -n "${tmp_manifest:-}" && -f "${tmp_manifest:-}" ]]; then
    rm -f "$tmp_manifest"
  fi
  exit "$exit_code"
}
trap cleanup EXIT

usage() {
  cat <<'EOF'
Usage: buildit <profile> [--dry-run]
       buildit --dry-run <profile>

Options:
  --dry-run   Validate manifest and simulate APT actions without installing
  -h, --help  Show this help message
EOF
}

log_msg() {
  local level="$1"
  shift
  local msg="[$(date '+%Y-%m-%d %H:%M:%S')] [$level] $*"
  echo "$msg"
  if [[ -n "${LOG_FILE:-}" && -f "${LOG_FILE:-}" ]]; then
    echo "$msg" >> "$LOG_FILE"
  fi
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
      *)
        if [[ -z "$PROFILE" ]]; then
          PROFILE="$1"
        else
          echo "Unexpected argument: $1" >&2
          usage >&2
          exit 1
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$PROFILE" ]]; then
    echo "ERROR: Profile is required." >&2
    usage >&2
    exit 1
  fi
}

init_logging() {
  mkdir -p "$RUN_DIR"
  : > "$LOG_FILE"
  mkdir -p "$LOG_ROOT"
  ln -sfn "$LOG_FILE" "${LOG_ROOT}/latest.log"
  log_msg "INFO" "Run ID: $RUN_ID | Branch: $BRANCH | Dry-run: $DRY_RUN"
  log_msg "INFO" "Full log: $LOG_FILE"
}

fetch_file() {
  local url="$1"
  local dest="$2"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$dest"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$dest" "$url"
  else
    return 1
  fi
}

expand_branch() {
  local raw="$1"
  printf '%s' "${raw//\$\{BRANCH\}/$BRANCH}"
}

load_profiles_conf() {
  tmp_conf="$(mktemp /tmp/buildit-profiles.XXXXXX)"

  if fetch_file "$PROFILES_URL" "$tmp_conf"; then
    log_msg "INFO" "Loaded profiles.conf from $PROFILES_URL"
    return 0
  fi

  if [[ -f "$LOCAL_PROFILES" ]]; then
    log_msg "WARN" "Remote profiles fetch failed; falling back to $LOCAL_PROFILES"
    cp "$LOCAL_PROFILES" "$tmp_conf"
    return 0
  fi

  log_msg "ERROR" "Failed to fetch $PROFILES_URL and local fallback not found at $LOCAL_PROFILES"
  return 1
}

lookup_profile() {
  local target="$1"
  local line p_name p_url p_local p_backup

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="$(printf '%s' "$line" | xargs)"
    [[ -z "$line" ]] && continue

    IFS='|' read -r p_name p_url p_local p_backup <<< "$line"
    if [[ "$p_name" == "$target" ]]; then
      MANIFEST_URL="$(expand_branch "${p_url:-}")"
      LOCAL_MANIFEST="$(expand_branch "${p_local:-}")"
      BACKUP_ROOT="$(expand_branch "${p_backup:-}")"
      return 0
    fi
  done < "$tmp_conf"

  return 1
}

load_manifest() {
  tmp_manifest="$(mktemp /tmp/buildit-manifest.XXXXXX)"

  if [[ -n "${MANIFEST_URL:-}" ]] && fetch_file "$MANIFEST_URL" "$tmp_manifest"; then
    log_msg "INFO" "Fetched manifest from $MANIFEST_URL"
    return 0
  fi

  if [[ -n "${LOCAL_MANIFEST:-}" && -f "$LOCAL_MANIFEST" ]]; then
    log_msg "WARN" "Remote manifest fetch failed; falling back to $LOCAL_MANIFEST"
    cp "$LOCAL_MANIFEST" "$tmp_manifest"
    return 0
  fi

  log_msg "ERROR" "Unable to load manifest for profile '$PROFILE' (url: ${MANIFEST_URL:-none}, local: ${LOCAL_MANIFEST:-none})"
  return 1
}

collect_packages() {
  local line pkg
  PACKAGES=()

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    pkg="$(printf '%s' "$line" | xargs)"
    [[ -z "$pkg" ]] && continue
    PACKAGES+=("$pkg")
  done < "$tmp_manifest"
}

run_apt() {
  if [[ "${#PACKAGES[@]}" -eq 0 ]]; then
    log_msg "WARN" "No packages found in manifest for profile '$PROFILE'"
    return 0
  fi

  log_msg "INFO" "Packages queued (${#PACKAGES[@]}): ${PACKAGES[*]}"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log_msg "INFO" "[DRY-RUN] Running apt-get update and simulated install..."
    apt-get update >> "$LOG_FILE" 2>&1
    apt-get install -s -y "${PACKAGES[@]}" | tee -a "$LOG_FILE"
  else
    log_msg "INFO" "Running apt-get update and install..."
    apt-get update >> "$LOG_FILE" 2>&1
    apt-get install -y "${PACKAGES[@]}" | tee -a "$LOG_FILE"
  fi
}

main() {
  parse_args "$@"

  if [[ "$EUID" -ne 0 ]]; then
    echo "ERROR: Please run buildit as root (e.g., sudo bash ./buildit ...)." >&2
    exit 1
  fi

  init_logging
  load_profiles_conf

  MANIFEST_URL=""
  LOCAL_MANIFEST=""
  BACKUP_ROOT=""

  if ! lookup_profile "$PROFILE"; then
    log_msg "ERROR" "Profile not found in profiles.conf: $PROFILE"
    exit 1
  fi

  if [[ -z "${BACKUP_ROOT:-}" ]]; then
    log_msg "ERROR" "Empty backup root for profile '$PROFILE'"
    exit 1
  fi

  mkdir -p "$BACKUP_ROOT"
  log_msg "INFO" "Backup directory ready: $BACKUP_ROOT"

  load_manifest
  collect_packages
  run_apt

  log_msg "INFO" "Completed profile '$PROFILE' successfully."
}

main "$@"
